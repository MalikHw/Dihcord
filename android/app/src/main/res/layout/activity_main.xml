<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- status / what is being sent -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:text="Not running" />

    <TextView
        android:id="@+id/sending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Start Listening for presence" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/open_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open game?" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_shortcut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add home shortcut to open the game w/ presence on" />

    <!-- log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Logcat"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />
</LinearLayout>
